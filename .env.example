# ===== Database =====
# PostgreSQL connection string. On Vercel, use e.g. Neon or Supabase.
DATABASE_URL=postgres://user:pass@host:5432/snakes_hosting?sslmode=require

# ===== Discord OAuth (web) =====
# Create an app at https://discord.com/developers/applications
# OAuth2 redirect URL must match exactly.
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=https://yourdomain.com/api/auth/discord/callback
DISCORD_GUILD_ID=your_guild_id

# Role name that grants the PAID tier.
PAID_ROLE_NAME=Paid

# ===== Bot =====
DISCORD_BOT_TOKEN=your_bot_token
SITE_URL=https://yourdomain.com

# ===== Control API / session =====
# URL of the web app (used internally by the worker/bot).
CONTROL_URL=https://yourdomain.com
# A long random secret shared between web, worker, and bot.
CONTROL_API_SECRET=super-secret-random-string
SESSION_SECRET=another-random-secret

# ===== Worker (VPS only) =====
# Absolute path on the VPS to the game backend source (server.js inside).
BACKEND_DIR=/opt/backends/server
# Where the VPS worker starts assigning ports.
START_PORT=3800
# Max concurrent backend processes this node will host.
MAX_INSTANCES=20
# A label for this worker node.
WORKER_HOST=vps-1
# Publicly reachable hostname/IP of this VPS (shown to users as the connection URL).
WORKER_PUBLIC_HOST=vps.example.com
# Port the inbound daemon API (file manager / logs / restart) listens on.
WORKER_API_PORT=4770