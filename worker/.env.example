# Copy to .env in this folder.

# Vercel control-plane URL (no trailing slash) and shared secret.
CONTROL_URL=https://www.rayvo.me
CONTROL_API_SECRET=change-me

# PostgreSQL (use a non-pooled direct URL on the VPS).
DATABASE_URL=postgresql://user:pass@host:5432/neondb

# Absolute path to the template backend that will be copied per instance.
# Must contain server.js.
BACKEND_DIR=/opt/backends/server

# Where per-instance copies live (defaults to <BACKEND_DIR parent>/instances).
# INSTANCES_DIR=/opt/backends/instances

# Cases for per-instance servers.
START_PORT=3800
MAX_INSTANCES=20

# Public reachable IP/hostname of this worker (for public_url + web callback).
WORKER_HOST=default
WORKER_PUBLIC_HOST=127.0.0.1

# Port the inbound daemon API (file manager / logs / restart) listens on.
WORKER_API_PORT=4770