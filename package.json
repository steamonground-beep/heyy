{
  "name": "snakes-hosting",
  "version": "1.0.0",
  "private": true,
  "description": "Hosting platform for game backend instances managed via Discord",
  "workspaces": [
    "web",
    "discord-bot",
    "worker",
    "shared"
  ],
  "scripts": {
    "dev:web": "npm --workspace web run dev",
    "dev:bot": "npm --workspace discord-bot run dev",
    "dev:worker": "npm --workspace worker run dev",
    "db:schema": "psql -d snakes_hosting -f db/schema.sql",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  }
}
